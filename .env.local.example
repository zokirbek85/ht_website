# Copy this file to .env.local and set real values before deploying.

# Password for /admin — change this before going live.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me

# Public site URL, used in sitemap.xml / robots.txt. Defaults to https://hazorasp-textil.uz if unset.
NEXT_PUBLIC_SITE_URL=https://hazorasp-textil.uz
