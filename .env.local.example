# Copy this file to .env.local and set real values before deploying.

# Password for /admin — change this before going live.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me

# Public site URL, used in sitemap.xml / robots.txt. Defaults to https://hazorasp-textil.uz if unset.
NEXT_PUBLIC_SITE_URL=https://hazorasp-textil.uz

# Telegram bot used to deliver /contact form submissions.
# Create a bot via @BotFather to get the token, then message the bot once and
# call https://api.telegram.org/bot<token>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me

# --- PTZ Analytics (separate Telegram bot) ---------------------------------

# Token for a SEPARATE bot created via @BotFather, dedicated to PTZ Excel
# imports/reporting. Do not reuse TELEGRAM_BOT_TOKEN above.
PTZ_BOT_TOKEN=change-me

# Random string Telegram must echo back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call, so random
# requests to /api/ptz-bot/webhook are rejected. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Then run `npm run ptz:set-webhook` once to register it with Telegram.
PTZ_BOT_WEBHOOK_SECRET=change-me

# Comma-separated Telegram numeric user IDs pre-authorized as PTZ admins
# before any admin exists in the database (chicken-and-egg bootstrap for
# /settings and user management). Get a user's numeric ID by having them
# message @userinfobot.
PTZ_ADMIN_TELEGRAM_IDS=
